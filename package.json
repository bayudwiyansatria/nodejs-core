{
  "name": "@bayudwiyansatria/core",
  "version": "1.0.0",
  "description": "The vendor-neutral kernel: capability interfaces, configuration resolution, structured logging, and the service response contract",
  "keywords": [
    "typescript",
    "kernel",
    "capabilities",
    "configuration",
    "logging",
    "hexagonal"
  ],
  "homepage": "https://bayudwiyansatria.github.io/nodejs-core",
  "bugs": {
    "url": "https://github.com/bayudwiyansatria/nodejs-core/issues",
    "email": "bayudwiyansatria@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Bayu Dwiyan Satria",
    "email": "bayudwiyansatria@gmail.com",
    "url": "https://bayudwiyansatria.github.io"
  },
  "contributors": [],
  "maintainers": [],
  "main": "lib/index.min.cjs",
  "type": "module",
  "types": "lib/index.d.ts",
  "module": "lib/index.min.mjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.min.mjs",
      "require": "./lib/index.min.cjs",
      "default": "./lib/index.min.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "!lib/*.map"
  ],
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bayudwiyansatria/nodejs-core.git"
  },
  "scripts": {
    "dev": "rollup -c rollup.config.ts --watch",
    "build": "rollup -c rollup.config.ts",
    "build:all": "npm run build && npm run build:static",
    "build:static": "npm run build:docs:coverage && npm run build:docs && npm run build:docs:book && shx mkdir -p dist && shx cp -f docker/nginx/index.html dist/index.html",
    "build:docs": "typedoc",
    "build:docs:coverage": "npm run test:run",
    "build:docs:book": "honkit build docs ../dist/book",
    "docker:build:docs": "docker compose -f docker/docker-compose.docs.yaml build --no-cache",
    "docker:serve:docs": "docker compose -f docker/docker-compose.docs.yaml up",
    "format": "prettier --write '*.{json,js}' 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
    "lint": "npm run lint:run",
    "lint:run": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "npm run lint && npm run test:run",
    "test:run": "jest --config jest.config.json"
  },
  "config": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-eslint": "^9.1.0",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^17.7.0",
    "honkit": "^6.2.2",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "prettier": "^3.4.2",
    "rollup": "^2.79.1",
    "rollup-plugin-dts": "^4.2.2",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-serve": "^2.0.1",
    "shx": "^0.4.0",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.28.20",
    "typescript": "5.0.4",
    "typescript-eslint": "^8.65.0"
  },
  "bundledDependencies": [],
  "private": false,
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "bundleDependencies": [],
  "overrides": {
    "rollup-plugin-dts": {
      "typescript": "$typescript"
    },
    "@rollup/plugin-eslint": {
      "eslint": "$eslint"
    },
    "@jest/reporters": {
      "glob": "^11.1.0"
    },
    "jest-config": {
      "glob": "^11.1.0"
    },
    "jest-runtime": {
      "glob": "^11.1.0"
    },
    "test-exclude": "^8.0.0",
    "minimatch@3": {
      "brace-expansion": "^1.1.17"
    },
    "undici": "^7.29.0"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false
  }
}
