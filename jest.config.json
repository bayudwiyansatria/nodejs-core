{
  "bail": true,
  "clearMocks": true,
  "collectCoverage": true,
  "collectCoverageFrom": [
    "src/**/*.{ts,tsx}"
  ],
  "coverageDirectory": "./dist/coverage",
  "coveragePathIgnorePatterns": [
    "node_modules"
  ],
  "coverageReporters": [
    "lcovonly",
    "html",
    "json",
    "clover",
    "text"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "moduleDirectories": [
    "node_modules"
  ],
  "modulePaths": [
    "node_modules"
  ],
  "moduleFileExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "json"
  ],
  "preset": "ts-jest",
  "testRegex": ".spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": [
      "ts-jest",
      {
        "tsconfig": "./tsconfig.test.json"
      }
    ],
    "^.+\\.(t|j)s?$": [
      "ts-jest",
      {
        "tsconfig": "./tsconfig.test.json"
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/.+.(js|jsx)$",
    "node_modules/.+.(ts|tsx)$"
  ],
  "verbose": true
}
